; train_eval_infer.config
; 2026/10/02 (C) antillia.com

; Fazekas segmentation
[model]
model         = "TensorFlowFlexUNet"
generator     =  False

image_width    = 512
image_height   = 512
image_channels = 3
input_normalize = True
normalization  = False
num_classes    = 2
base_filters   = 16
base_kernels   = (11,11)

num_layers     = 8
dropout_rate   = 0.05
dilation       = (3,3)

; Model compilation parameters
optimizer       = "Adam"

learning_rate  = 0.00007
clipvalue      = 0.4

;loss           = "categorical_crossentropy"
;2026/09/23  Modified to use "categorical_focal_dice_loss"
loss           = "categorical_focal_dice_loss"

;metrics        = ["dice_coef_multiclass"]
;2026/09/25 Modified to use "dice_coef_hybrid".
metrics        = ["dice_coef_hybrid"]
hybrid_alpha   = 1.6
hybrid_beta    = 0.4

show_summary   = False

[dataset]
class_name    = "ImageCategorizedMaskDataset"

[train]
;epochs       = 50
epochs        = 100
batch_size    = 2

;steps_per_epoch  = 200
;validation_steps = 80

; EarlyStopping parameter
patience      = 10

; 2026/09/23 Modified the following line.
; metrics       = ["dice_coef_multiclass", "val_dice_coef_multiclass]
metrics       = ["dice_coef_hybrid", "val_dice_coef_hybrid"]

model_dir     = "./models/"
eval_dir      = "./eval/"
images_dir    = "../../../dataset/Fazekas/train/images/"
masks_dir     = "../../../dataset/Fazekas/train/masks/"

create_backup  = False

; learning_rate_reducer callback parameter
learning_rate_reducer = True
reducer_factor     = 0.4
reducer_patience   = 4

; Model saving option
save_weights_only  = True

[valid]
images_dir = "../../../dataset/Fazekas/valid/images/"
masks_dir  = "../../../dataset/Fazekas/valid/masks/"

[test] 
images_dir = "../../../dataset/Fazekas/test/images/"
masks_dir  = "../../../dataset/Fazekas/test/masks/"

[infer] 
images_dir    = "./mini_test/images/"
output_dir    = "./mini_test_output/"

[image]
color_order = "RGB"

[mask]
mask_datatyoe    = "categorized"
mask_file_format = ".png"
;Fazekas RGB color map dict for 1+1 classes.
;                SNFH (Surrounding non-enhancing FLAIR hyperintensity): white 
rgb_map = {(0,0,0):0,(255,255,255):1,}


